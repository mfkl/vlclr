<Project Sdk="Microsoft.NET.Sdk">

  <!--
    C# port of VLC's gaussianblur video filter, built as a VLC 4 plugin with
    Native AOT for the C vs C# comparison (see ../README.md).

    Instruction set, to match the C build being compared:
      dotnet publish -c Release -f net10.0                   baseline x86-64 (like clang's default)
      dotnet publish -c Release -f net10.0 -p:BlurIsa=avx2   AVX2 (like clang -mavx2)
  -->
  <PropertyGroup>
    <!-- Runtimes to compare; net11.0 needs a .NET 11 SDK (build from outside
         the repo, whose global.json pins SDK 10): -p:BlurTfms=net11.0 -->
    <BlurTfms Condition="'$(BlurTfms)' == ''">net8.0;net10.0</BlurTfms>
    <TargetFrameworks>$(BlurTfms)</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- One plugin per runtime (libdotnet_gaussianblur_net8_plugin.dll, ...),
         so all of them can be installed in the same VLC at once. -->
    <BlurIsa Condition="'$(BlurIsa)' == ''">baseline</BlurIsa>
    <BlurIsaSuffix Condition="'$(BlurIsa)' == 'avx2'">_avx2</BlurIsaSuffix>
    <AssemblyName>libdotnet_gaussianblur_$(TargetFramework.Replace('.0', ''))$(BlurIsaSuffix)_plugin</AssemblyName>
    <OptimizationPreference>Speed</OptimizationPreference>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StackTraceSupport>false</StackTraceSupport>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>link</TrimMode>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <!-- x86-64-v2 for every runtime: .NET 11 no longer accepts plain x86-64,
       and comparing runtimes needs the same target. -->
  <PropertyGroup Condition="'$(BlurIsa)' == 'baseline'">
    <IlcInstructionSet>x86-64-v2</IlcInstructionSet>
    <!-- Same group, .NET 8 spelling. -->
    <IlcInstructionSet Condition="'$(TargetFramework)' == 'net8.0'">x86-x64-v2</IlcInstructionSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BlurIsa)' == 'avx2'">
    <IlcInstructionSet>x86-64-v3</IlcInstructionSet>
    <IlcInstructionSet Condition="'$(TargetFramework)' == 'net8.0'">x86-x64-v3</IlcInstructionSet>
    <DefineConstants>$(DefineConstants);BLUR_ISA_AVX2</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\VLCLR\VLCLR.csproj" />
    <ProjectReference Include="..\..\..\src\VLCLR.Filters\VLCLR.Filters.csproj" />
    <ProjectReference Include="..\..\..\src\VLCLR.Generators\VLCLR.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <DirectPInvoke Include="libvlccore" />
    <NativeLibrary Include="$(VlcSdkLibvlccore)" Condition="'$(VlcSdkLibvlccore)' != ''" />
    <NativeLibrary Include="..\..\..\lib\libvlccore.lib" Condition="'$(VlcSdkLibvlccore)' == ''" />
  </ItemGroup>

</Project>
