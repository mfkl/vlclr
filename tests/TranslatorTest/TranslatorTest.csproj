<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>

  <!-- Include source files from SubtitleTranslator directly (avoids RID conflicts) -->
  <ItemGroup>
    <Compile Include="..\..\samples\SubtitleTranslator\SimpleTokenizer.cs" Link="SimpleTokenizer.cs" />
    <Compile Include="..\..\samples\SubtitleTranslator\OnnxTranslator.cs" Link="OnnxTranslator.cs" />
    <Compile Include="..\..\samples\SubtitleTranslator\TranslationCache.cs" Link="TranslationCache.cs" />
  </ItemGroup>

</Project>
