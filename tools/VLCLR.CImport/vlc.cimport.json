{
  // Pinned VLC headers. fetch-headers.ps1 / fetch-headers.sh fill includeDir
  // and symbols (libvlccore's export list).
  "vlc": {
    "repository": "https://code.videolan.org/videolan/vlc.git",
    "commit": "942cdaea17fc2daa9cb2b8098a3c9b8560aef1fb",
    "includeDir": "../../artifacts/vlc-headers/include",
    "symbols": "../../artifacts/vlc-headers/libvlccore.sym"
  },
  // One translation unit: vlc_common.h first, then every other public header
  // ("*", in name order), but the ones that do not parse on their own.
  "headers": ["vlc_common.h", "*"],
  "excludeHeaders": [
    "vlc_fixups.h",   // the replacement functions of VLC's own build, needs its config.h
    "vlc_gcrypt.h",   // needs libgcrypt's headers
    "vlc_xlib.h"      // needs Xlib's headers
  ],
  // As VLC's build defines them (configure.ac, meson.build): libvlccore's
  // layouts are those of these settings.
  "defines": ["_FILE_OFFSET_BITS=64", "HAVE_ATTRIBUTE_PACKED"],
  "abiDefines": {
    "windows": ["WIN32_LEAN_AND_MEAN", "UNICODE"]
  },
  "prelude": {},
  // Every symbol the headers declare. Records reached only through pointers
  // stay opaque, unless a header defines them.
  "roots": ["*"],
  "excludes": [],
  "output": {
    "namespace": "VLCLR.Native.Interop",
    "library": "libvlccore",
    "directory": "../../src/VLCLR/Native/Interop",
    "probe": "../../tests/AbiValidation/vlclr_abi.g.c",
    // MSVC is not a VLC compiler; it checks what it can parse.
    "probeMsvcExcludeHeaders": [
      "vlc_codecs.h",    // GCC's packed attribute
      "vlc_cpu.h",       // x86 constants under __x86_64__, which MSVC does not define
      "vlc_network.h",   // POSIX headers (unistd.h)
      "vlc_opengl_picture.h", // C99 array parameters
      "vlc_opengl_sampler.h", // includes vlc_opengl_picture.h
      "vlc_poll.h",
      "vlc_spawn.h",
      "vlc_tls.h"
    ],
    "layoutTests": "../../src/VLCLR.Tests/Interop/InteropLayoutTests.g.cs"
  },
  "names": {
    // vlc_object_t would become "Object", which reads as System.Object. The
    // hand-written equivalent is VLCObjectHeader.
    "types": {
      "vlc_object_t": "ObjectHeader",
      // The rules give these the name of another type.
      "vlc_sockaddr": "VlcSockaddr",            // struct sockaddr is Sockaddr
      "vlc_thread_t": "ThreadHandle",           // struct vlc_thread (windows) is Thread
      "vlc_tracer_value": "TracerValueType"     // the enum; the union vlc_tracer_value_t is TracerValue
    },
    "fields": {
      // i_count / p_items pairs strip to the same name; the rules add Count
      // to the i_ field, these sizes read better as Size.
      "es_format_t.i_extra_languages": "ExtraLanguagesCount",
      "es_format_t.i_extra": "ExtraSize",
      "vlc_frame_t.i_buffer": "BufferSize",
      "subs_format_t::spu.b_palette": "HasPalette",
      // Pairs the rules do not settle.
      "module_config_t.psz_type": "Subtype",   // i_type is the type, psz_type its subtype
      "sout_input_t.p_fmt": "FmtPointer",      // fmt is the es_format_t itself
      "sout_mux_t.pf_mux": "MuxCallback"       // psz_mux is the muxer's name
    },
    "enumMembers": {},
    "functions": {
      // No prefix_Verb split: the rules would file these under their header class.
      "vlc_object_parent": "VlcObject.Parent",
      "vlc_object_typename": "VlcObject.Typename",
      "vlc_tick_now": "VlcTick.Now",
      // Named like their class, which C# does not allow.
      "demux_Demux": "Demux.Run",
      "vlc_spawn": "VlcSpawn.Spawn"
    },
    "constants": {},
    "headers": {}
  }
}
