<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net10.0 is the primary target. net8.0 (LTS) is supported for plugins
      that must build against an older runtime; .NET 9+ APIs are guarded
      with #if NET9_0_OR_GREATER.
    -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VLCLR.Tests" />
  </ItemGroup>

  <!-- Plugin build settings (feature switches); imported by the package's consumers -->
  <ItemGroup>
    <None Include="build\VLCLR.targets" Pack="true" PackagePath="build" />
  </ItemGroup>

  <!-- .NET 9+ takes the switches' values from FeatureSwitchDefinition; net8.0 from this -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <EmbeddedResource Include="ILLink.Substitutions.xml" LogicalName="ILLink.Substitutions.xml" />
  </ItemGroup>

  <!-- Include the source generator for consumers of this package -->
  <ItemGroup>
    <ProjectReference Include="..\VLCLR.Generators\VLCLR.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
