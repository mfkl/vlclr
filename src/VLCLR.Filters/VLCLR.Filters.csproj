<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ready-made filter engines for VLCLR plugins. Each one works on VLC
    pictures (VLCFrame); a plugin wraps it in a VLCVideoFilterBase with its
    own [VLCModule] / [VLCConfig] attributes (see samples/GaussianBlur).
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VLCLR\VLCLR.csproj" />
  </ItemGroup>

</Project>
