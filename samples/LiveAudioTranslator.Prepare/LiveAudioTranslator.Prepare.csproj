<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>LiveAudioTranslator.Prepare</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\LiveAudioTranslator\StreamingAudioSegmenter.cs" Link="Core\StreamingAudioSegmenter.cs" />
    <Compile Include="..\LiveAudioTranslator\TimedCue.cs" Link="Core\TimedCue.cs" />
    <Compile Include="..\LiveAudioTranslator\TimedCueFile.cs" Link="Core\TimedCueFile.cs" />
    <Compile Include="..\LiveAudioTranslator\TranscriptStitcher.cs" Link="Core\TranscriptStitcher.cs" />
    <Compile Include="..\SubtitleTranslator\ITranslationEngine.cs" Link="Translation\ITranslationEngine.cs" />
    <Compile Include="..\SubtitleTranslator\ModelManifest.cs" Link="Translation\ModelManifest.cs" />
    <Compile Include="..\SubtitleTranslator\OnnxNativeResolver.cs" Link="Translation\OnnxNativeResolver.cs" />
    <Compile Include="..\SubtitleTranslator\OnnxSessionFactory.cs" Link="Translation\OnnxSessionFactory.cs" />
    <Compile Include="..\SubtitleTranslator\OnnxTranslator.cs" Link="Translation\OnnxTranslator.cs" />
    <Compile Include="..\SubtitleTranslator\SimpleTokenizer.cs" Link="Translation\SimpleTokenizer.cs" />
    <Compile Include="..\SubtitleTranslator\TranslationCache.cs" Link="Translation\TranslationCache.cs" />
    <Compile Include="..\SubtitleTranslator\TranslationTextNormalizer.cs" Link="Translation\TranslationTextNormalizer.cs" />
  </ItemGroup>

</Project>
